GROQ_API_KEY=
# Get a free key at https://console.groq.com/keys — Groq's free tier has
# generous per-minute rate limits. See https://console.groq.com/docs/models
# for the current model list if you want to swap this.
GROQ_MODEL=qwen/qwen3.6-27b

COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

CHROMA_PERSIST_DIRECTORY=./data/chroma

HYBRID_ALPHA=0.7

MAX_FILE_SIZE_MB=20

# Comma-separated list of allowed origins. Never use "*" in production —
# set this to your exact Netlify domain, e.g. https://your-app.netlify.app
CORS_ORIGINS=http://localhost:5500

DEBUG_RAG=false
